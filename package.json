{
  "name": "dsh-argon",
  "version": "0.0.2",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "private": true,
  "description": "Argon writing-style prompt plugin for DeepSeek Harness: injects the task charter, writing/delivery rules, Galgame/manga/novel translation and polishing rules, and the Argon style fingerprint into standard, ptc, cordis, minimal, and subagent prompts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/h-void/dsh-argon.git"
  },
  "homepage": "https://github.com/h-void/dsh-argon#readme",
  "bugs": "https://github.com/h-void/dsh-argon/issues",
  "type": "module",
  "main": "src/node.js",
  "exports": {
    ".": "./src/node.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "check": "node --check src/node.js && node --check src/rules.js && node --check lib/client.js",
    "test": "node --test --test-isolation=none"
  }
}
